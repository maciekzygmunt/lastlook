{
  "name": "@reviewd/server",
  "version": "0.1.0",
  "description": "reviewd — local diff-review server",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "reviewd": "dist/cli.js"
  },
  "files": [
    "dist"
