{
  "name": "@reviewd/server",
  "version": "0.1.0",
  "description": "reviewd — local diff-review server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maciekzygmunt/diff.git",
    "directory": "packages/server"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "reviewd": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-web.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
