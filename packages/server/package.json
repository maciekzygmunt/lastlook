{
  "name": "lastlook",
  "version": "0.1.4",
  "description": "One last look before you ship — local code review for agent-written changes, with inline comments your agent resolves over HTTP",
  "license": "MIT",
  "author": "Maciej Zygmunt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maciekzygmunt/lastlook.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/maciekzygmunt/lastlook#readme",
  "bugs": {
    "url": "https://github.com/maciekzygmunt/lastlook/issues"
  },
  "keywords": [
    "code-review",
    "diff",
    "git",
    "ai-agents",
    "claude-code",
    "cli",
    "localhost"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "lastlook": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-web.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "hono": "^4.6.14",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
